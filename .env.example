PORT=3000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# Recommended for the backend (bypasses RLS). Keep secret, never expose to the browser.
SUPABASE_SERVICE_KEY=
# Fallback if the service key is not set
SUPABASE_ANON_KEY=

# LLM (Groq)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile   # default: llama-3.1-8b-instant
# ENABLE_UK=false                      # skip Ukrainian summaries to save tokens

# Protects POST /api/defrag/run
DEFRAG_SECRET=change-me

# Ingestion tuning (optional)
# INGEST_CRON=0 */3 * * *
# MAX_PER_RUN=60
# CONCURRENCY=3
# LLM_MIN_INTERVAL_MS=2500
# WINDOW_HOURS=48
